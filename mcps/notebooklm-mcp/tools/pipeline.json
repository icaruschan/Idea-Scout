{
  "name": "pipeline",
  "description": "Manage and execute multi-step notebook pipelines.\n\nActions:\n- run: Execute a pipeline on a notebook\n- list: List all available pipelines (builtin and user-defined)",
  "inputSchema": {
    "additionalProperties": false,
    "properties": {
      "action": {
        "type": "string",
        "description": "Operation to perform (run, list)"
      },
      "notebook_id": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Target notebook UUID (required for action=run)"
      },
      "pipeline_name": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Pipeline name (required for action=run, e.g. \"ingest-and-podcast\")"
      },
      "input_url": {
        "default": "",
        "type": "string",
        "description": "URL variable for pipelines that need it (replaces $INPUT_URL)"
      }
    },
    "required": [
      "action"
    ],
    "type": "object"
  }
}