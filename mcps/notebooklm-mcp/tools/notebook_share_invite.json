{
  "name": "notebook_share_invite",
  "description": "Invite a collaborator by email.",
  "inputSchema": {
    "additionalProperties": false,
    "properties": {
      "notebook_id": {
        "type": "string",
        "description": "Notebook UUID"
      },
      "email": {
        "type": "string",
        "description": "Email address to invite"
      },
      "role": {
        "default": "viewer",
        "type": "string",
        "description": "\"viewer\" or \"editor\" (default: viewer)"
      }
    },
    "required": [
      "notebook_id",
      "email"
    ],
    "type": "object"
  }
}