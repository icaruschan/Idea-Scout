{
  "name": "note",
  "description": "Manage notes in a notebook. Unified tool for all note operations.\n\nSupports: create, list, update, delete",
  "inputSchema": {
    "additionalProperties": false,
    "properties": {
      "notebook_id": {
        "type": "string",
        "description": "Notebook UUID"
      },
      "action": {
        "type": "string",
        "description": "Operation to perform:\n- create: Create a new note\n- list: List all notes in notebook\n- update: Update an existing note\n- delete: Delete a note permanently (requires confirm=True)"
      },
      "note_id": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Note UUID (required for update/delete)"
      },
      "content": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Note content (required for create, optional for update)"
      },
      "title": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Note title (optional for create/update)"
      },
      "confirm": {
        "default": false,
        "type": "boolean",
        "description": "Must be True for delete action"
      }
    },
    "required": [
      "notebook_id",
      "action"
    ],
    "type": "object"
  }
}