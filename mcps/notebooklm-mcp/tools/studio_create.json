{
  "name": "studio_create",
  "description": "Create any NotebookLM studio artifact. Unified creation tool.\n\nSupports: audio, video, infographic, slide_deck, report, flashcards, quiz, data_table, mind_map",
  "inputSchema": {
    "additionalProperties": false,
    "properties": {
      "notebook_id": {
        "type": "string",
        "description": "Notebook UUID"
      },
      "artifact_type": {
        "type": "string",
        "description": "Type of artifact to create:\n- audio: Audio Overview (podcast)\n- video: Video Overview\n- infographic: Visual infographic\n- slide_deck: Presentation slides (PDF)\n- report: Text report (Briefing Doc, Study Guide, etc.)\n- flashcards: Study flashcards\n- quiz: Multiple choice quiz\n- data_table: Structured data table\n- mind_map: Visual mind map"
      },
      "source_ids": {
        "anyOf": [
          {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Source IDs to use (default: all sources)"
      },
      "confirm": {
        "default": false,
        "type": "boolean",
        "description": "Must be True after user approval"
      },
      "audio_format": {
        "default": "deep_dive",
        "type": "string"
      },
      "audio_length": {
        "default": "default",
        "type": "string"
      },
      "video_format": {
        "default": "explainer",
        "type": "string"
      },
      "visual_style": {
        "default": "auto_select",
        "type": "string"
      },
      "video_style_prompt": {
        "default": "",
        "type": "string"
      },
      "orientation": {
        "default": "landscape",
        "type": "string"
      },
      "detail_level": {
        "default": "standard",
        "type": "string"
      },
      "infographic_style": {
        "default": "auto_select",
        "type": "string"
      },
      "slide_format": {
        "default": "detailed_deck",
        "type": "string"
      },
      "slide_length": {
        "default": "default",
        "type": "string"
      },
      "report_format": {
        "default": "Briefing Doc",
        "type": "string"
      },
      "custom_prompt": {
        "default": "",
        "type": "string"
      },
      "question_count": {
        "default": 2,
        "type": "integer"
      },
      "difficulty": {
        "default": "medium",
        "type": "string"
      },
      "language": {
        "default": "",
        "type": "string"
      },
      "focus_prompt": {
        "default": "",
        "type": "string"
      },
      "title": {
        "default": "Mind Map",
        "type": "string"
      },
      "description": {
        "default": "",
        "type": "string"
      }
    },
    "required": [
      "notebook_id",
      "artifact_type"
    ],
    "type": "object"
  }
}