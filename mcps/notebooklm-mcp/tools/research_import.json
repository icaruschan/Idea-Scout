{
  "name": "research_import",
  "description": "Import discovered sources into notebook.\n\nCall after research_status shows status=\"completed\".",
  "inputSchema": {
    "additionalProperties": false,
    "properties": {
      "notebook_id": {
        "type": "string",
        "description": "Notebook UUID"
      },
      "task_id": {
        "type": "string",
        "description": "Research task ID"
      },
      "source_indices": {
        "anyOf": [
          {
            "items": {
              "type": "integer"
            },
            "type": "array"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Source indices to import (default: all)"
      },
      "timeout": {
        "default": 300.0,
        "type": "number",
        "description": "Import timeout in seconds (default: 300, increase for large notebooks)"
      },
      "cited_only": {
        "default": false,
        "type": "boolean",
        "description": "Import only sources cited by the research report.\nOverrides source_indices when enabled."
      }
    },
    "required": [
      "notebook_id",
      "task_id"
    ],
    "type": "object"
  }
}