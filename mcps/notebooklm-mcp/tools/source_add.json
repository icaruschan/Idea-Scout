{
  "name": "source_add",
  "description": "Add a source to a notebook. Unified tool for all source types.\n\nSupports: url, text, drive, file",
  "inputSchema": {
    "additionalProperties": false,
    "properties": {
      "notebook_id": {
        "type": "string",
        "description": "Notebook UUID"
      },
      "source_type": {
        "type": "string",
        "description": "Type of source to add:\n- url: Web page or YouTube URL\n- text: Pasted text content\n- drive: Google Drive document\n- file: Local file upload. Supported extensions:\n    PDF, TXT, MD, DOCX, CSV, EPUB, MP3, M4A, WAV, AAC, OGG,\n    OPUS, MP4, JPG, JPEG, PNG, GIF, WEBP. Image-bearing\n    sources (PDF / JPG / PNG / etc.) feed Studio video\n    generation's visual-crop pipeline — charts, photos, and\n    diagrams may be extracted as on-screen aids in Video\n    Overviews."
      },
      "url": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "URL to add (for source_type=url)"
      },
      "urls": {
        "anyOf": [
          {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "List of URLs to add in bulk (for source_type=url, alternative to url)"
      },
      "text": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Text content to add (for source_type=text)"
      },
      "title": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Display title (for text sources)"
      },
      "file_path": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Local file path (for source_type=file)"
      },
      "document_id": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Google Drive document ID (for source_type=drive)"
      },
      "doc_type": {
        "default": "doc",
        "type": "string",
        "description": "Drive doc type: doc|slides|sheets|pdf (for source_type=drive)"
      },
      "wait": {
        "default": false,
        "type": "boolean",
        "description": "If True, wait for source processing to complete before returning"
      },
      "wait_timeout": {
        "default": 120.0,
        "type": "number",
        "description": "Max seconds to wait if wait=True (default 120)"
      }
    },
    "required": [
      "notebook_id",
      "source_type"
    ],
    "type": "object"
  }
}