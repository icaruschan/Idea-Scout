{
  "name": "tools_documentation",
  "description": "Get tool docs. Pass optional depth (string). Example: {\"depth\": \"essentials\"} or {}",
  "inputSchema": {
    "type": "object",
    "properties": {
      "topic": {
        "type": "string",
        "description": "Optional string tool name like \"search_nodes\""
      },
      "depth": {
        "type": "string",
        "enum": [
          "essentials",
          "full"
        ],
        "description": "Optional string: \"essentials\" (default) or \"full\"",
        "default": "essentials"
      }
    }
  }
}